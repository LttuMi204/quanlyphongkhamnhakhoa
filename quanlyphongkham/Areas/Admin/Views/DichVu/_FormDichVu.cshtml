@model quanlyphongkham.Models.DichVu
@{
    var isEdit = Model.MaDichVu > 0;
}

<form asp-action="@(isEdit ? "EditPartial" : "CreatePartial")" id="formDichVu">
    @Html.AntiForgeryToken()
    @if (isEdit)
    {
        <input type="hidden" asp-for="MaDichVu" />
    }

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Tên dịch vụ <span class="text-danger">*</span></label>
            <input asp-for="TenDichVu" class="form-control rounded-pill" required />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Loại dịch vụ</label>
            <select asp-for="LoaiDichVu" class="form-select rounded-pill">
                <option value="Tổng quát">Tổng quát</option>
                <option value="Thẩm mỹ">Thẩm mỹ</option>
                <option value="Chỉnh nha">Chỉnh nha</option>
                <option value="Implant">Implant</option>
            </select>
        </div>
    </div>

    @if (!isEdit)
    {
        <div class="row">
            <div class="col-md-12 mb-3">
                <label class="form-label fw-bold text-primary">Đơn giá khởi tạo (VNĐ)</label>
                <input type="number" name="DonGia" class="form-control rounded-pill" required min="0" step="1000" />
            </div>
        </div>
    }

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Thời gian (phút)</label>
            <input asp-for="ThoiGianThucHien" class="form-control rounded-pill" type="number" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label fw-bold">Trạng thái</label>
            <select asp-for="TrangThai" class="form-select rounded-pill">
                <option value="Khả dụng">Khả dụng</option>
                <option value="Ngưng">Ngưng</option>
            </select>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Mô tả</label>
        <textarea asp-for="MoTa" class="form-control rounded-3" rows="3"></textarea>
    </div>

    <div class="modal-footer px-0 pb-0 mt-4 border-top pt-3">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Lưu dịch vụ</button>
    </div>
</form>

<script>
    $('#formDichVu').submit(function (e) {
        e.preventDefault();
        $.post($(this).attr('action'), $(this).serialize(), function (res) {
            if (res.success) {
                toastr.success(res.message);
                $('#dichVuModal').modal('hide');
                loadDichVuList();
            } else {
                $('#dichVuModalBody').html(res);
            }
        });
    });
</script>