@model IEnumerable<quanlyphongkham.Models.DichVu>

@Html.AntiForgeryToken()

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Tên dịch vụ</th>
                <th>Phân loại</th>
                <th class="text-center">Thời gian</th>
                <th class="text-end">Giá hiện tại</th>
                <th class="text-center">Trạng thái</th>
                <th class="text-center" width="120">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@item.TenDichVu</strong>
                        @if (item.TrangThai == "Ngưng")
                        {
                            <span class="text-danger small ms-2 fst-italic">(Đã ngưng)</span>
                        }
                    </td>
                    <td><span class="badge bg-secondary">@item.LoaiDichVu</span></td>
                    <td class="text-center">@item.ThoiGianThucHien phút</td>
                    <td class="text-end fw-bold text-primary">@item.GiaHienTai.ToString("N0") đ</td>
                    <td class="text-center">
                        <span class="badge @(item.TrangThai == "Khả dụng" ? "bg-success" : "bg-danger")">@item.TrangThai</span>
                    </td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-info text-white" onclick="openPriceManager(@item.MaDichVu, '@item.TenDichVu')" title="Quản lý giá">
                            <i class="fas fa-coins"></i>
                        </button>

                        @if (item.TrangThai == "Khả dụng")
                        {
                            <button class="btn btn-sm btn-danger" onclick="toggleTrangThaiDichVu(@item.MaDichVu, '@item.TenDichVu', 'Ngưng')" title="Ngưng sử dụng">
                                <i class="fas fa-ban"></i>
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-success" onclick="toggleTrangThaiDichVu(@item.MaDichVu, '@item.TenDichVu', 'Khả dụng')" title="Khôi phục sử dụng">
                                <i class="fas fa-check-circle"></i>
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>