@model IEnumerable<quanlyphongkham.Models.NhanVien>

@{
    string search = ViewBag.Search ?? "";
    int? maLoaiNV = ViewBag.MaLoaiNV;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header py-3 bg-white d-flex justify-content-between align-items-center flex-wrap">
        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-list me-2"></i>Danh sách nhân sự</h6>
    </div>
    <div class="card-body">

        <form id="filterFormNhanVien" class="row g-2 mb-3" onsubmit="searchNhanVien(event)">
            <div class="col-md-8">
                <div class="input-group">
                    <input type="text" id="searchNV" class="form-control"
                           placeholder="Tìm tên, SĐT, email, tài khoản, chuyên khoa..."
                           value="@search"
                           oninput="debounceSearchNhanVien()" />

                    <select id="filterChucVu" class="form-select" style="max-width: 200px;" asp-items="ViewBag.LoaiNhanVienList" onchange="searchNhanVien(event)">
                        <option value="">Tất cả chức vụ</option>
                    </select>
                    <button type="submit" class="btn btn-info text-white">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </button>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã NV</th>
                        <th>Họ tên</th>
                        <th>SĐT</th>
                        <th>Chức vụ</th>
                        <th>Tài khoản</th>
                        <th>Trạng thái</th>
                        <th class="text-center" width="150">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                        // THÊM SỰ KIỆN ONCLICK VÀ CON TRỎ CHUỘT (CURSOR) VÀO TR
                            <tr style="cursor: pointer;" onclick="viewNhanVien(@item.MaNhanVien)" title="Nhấn để xem chi tiết">
                                <td>@item.MaNhanVien</td>
                                <td class="font-weight-bold text-primary">@item.HoTen</td>
                                <td>@item.SoDienThoai</td>
                                <td><span class="badge bg-info text-dark">@(item.LoaiNhanVien?.TenLoaiNV ?? "N/A")</span></td>
                                <td>
                                    @if (item.TaiKhoanNhanVien != null)
                                    {
                                        <span class="badge bg-secondary">@item.TaiKhoanNhanVien.TenDangNhap</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Chưa có</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsDeleted)
                                    {
                                        <span class="badge bg-danger">Đã nghỉ việc</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">@item.TrangThai</span>
                                    }
                                </td>

                                <td class="text-center" onclick="event.stopPropagation();">

                                    @* Đã cho click cả dòng để xem chi tiết rồi thì có thể giữ hoặc bỏ nút Xem (Eye) này cho gọn *@
                                    @* <button class="btn btn-sm btn-info text-white" onclick="viewNhanVien(@item.MaNhanVien)" title="Chi tiết">
                            <i class="fas fa-eye"></i>
                            </button> *@

                                    @if (ViewBag.IsDeleted != null && ViewBag.IsDeleted == true)
                                    {
                                        <button class="btn btn-sm btn-success" onclick="restoreNhanVien(@item.MaNhanVien)" title="Khôi phục nhân viên">
                                            <i class="fas fa-trash-restore"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-warning" onclick="openEditNhanVien(@item.MaNhanVien)" title="Sửa">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-danger" onclick="deleteNhanVien(@item.MaNhanVien)" title="Xóa">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted py-3">Không tìm thấy nhân viên nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center mb-0">

                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="javascript:void(0)" onclick="loadTabNhanSu(@(currentPage - 1))" aria-label="Previous">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="javascript:void(0)" onclick="loadTabNhanSu(@i)">@i</a>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="javascript:void(0)" onclick="loadTabNhanSu(@(currentPage + 1))" aria-label="Next">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </li>

                </ul>
            </nav>
        }
    </div>
</div>