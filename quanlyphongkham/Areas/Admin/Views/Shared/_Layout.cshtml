<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý phòng khám - lịch hẹn</title>

    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <style>
        /* --- CẤU HÌNH BIẾN MÀU (Giữ nguyên từ yêu cầu của Mi) --- */
        :root {
            --primary: #4e73df;
            --success: #1cc88a;
            --info: #36b9cc;
            --warning: #f6c23e;
            --danger: #e74a3b;
            --text-main: #5a5c69;
            --text-muted: #858796;
            --bg-body: #f8f9fc;
            --header-height: 60px;
            --border-color: #e3e6f0;
        }
        /* --- TÙY CHỈNH GIAO DIỆN SELECT2 CHO ĐỒNG BỘ BOOTSTRAP --- */
.select2-container .select2-selection--single {
    height: 38px !important; /* Chiều cao bằng với form-control mặc định */
    border: 1px solid var(--border-color) !important;
    border-radius: 0.375rem !important; /* Tương đương .rounded-3 */
    display: flex;
    align-items: center;
}
.select2-container--default .select2-selection--single .select2-selection__rendered {
    line-height: normal !important;
    color: var(--text-main) !important;
    padding-left: 0.75rem !important;
}
.select2-container--default .select2-selection--single .select2-selection__arrow {
    height: 100% !important;
    right: 5px !important;
}
/* Ô search bên trong dropdown */
.select2-search__field {
    border-radius: 4px !important;
}
        body {
            margin: 0;
            padding: 0;
            background-color: var(--bg-body);
            font-family: 'Be Vietnam Pro', sans-serif;
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* --- HEADER NGANG NHỎ GỌN --- */
        /* --- HEADER NGANG NHỎ GỌN --- */
        #top-header {
            background: #ffffff;
            border-bottom: 1px solid var(--border-color);
            box-shadow: 0 0.1rem 0.5rem rgba(0, 0, 0, 0.05);
            top: 0;
            z-index: 1030; /* <-- Đổi từ 1060 thành 1030 ở đây */
            height: var(--header-height);
            position: sticky; /* Thêm dòng này nếu muốn header luôn ghim trên cùng khi cuộn */
        }
        .nav-container {
            display: flex;
            align-items: center;
            height: 100%;
            padding: 0 1.5rem;
        }

        /* --- LOGO TINH GỌN --- */
        .brand-area {
            display: flex;
            align-items: center;
            text-decoration: none !important;
            margin-right: 1.5rem;
        }

        .logo-box {
            width: 32px;
            height: 32px;
            background: var(--primary);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1rem;
            margin-right: 8px;
        }

        .main-title {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--primary);
            white-space: nowrap;
        }

        /* --- MENU ĐIỀU HƯỚNG --- */
        .main-nav {
            flex-grow: 1;
        }

        .nav-links {
            display: flex;
            list-style: none;
            margin: 0;
            padding: 0;
            gap: 0.2rem;
        }

            .nav-links li a {
                padding: 0.5rem 0.8rem;
                text-decoration: none;
                color: var(--text-main);
                font-size: 0.9rem;
                font-weight: 500;
                border-radius: 8px;
                display: flex;
                align-items: center;
                transition: 0.2s;
            }

                .nav-links li a i {
                    margin-right: 6px;
                    color: var(--text-muted);
                    font-size: 0.95rem;
                }

                .nav-links li a:hover {
                    background: #f1f3f9;
                    color: var(--primary);
                }

            .nav-links li.active a {
                background: #eaecf4;
                color: var(--primary);
                font-weight: 700;
            }

                .nav-links li.active a i {
                    color: var(--primary);
                }

        /* --- USER & LOGOUT --- */
        .user-actions {
            margin-left: auto;
            display: flex;
            align-items: center;
            padding-left: 1rem;
            border-left: 1px solid var(--border-color);
        }

        .user-profile {
            text-align: right;
            margin-right: 1rem;
            line-height: 1.2;
        }

        .user-name {
            font-weight: 600;
            font-size: 0.85rem;
            display: block;
        }

        .user-role {
            font-size: 0.7rem;
            color: var(--success);
            font-weight: 600;
        }

        .btn-logout {
            width: 35px;
            height: 35px;
            background: #fff1f0;
            color: var(--danger);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            text-decoration: none !important;
            transition: 0.3s;
        }

            .btn-logout:hover {
                background: var(--danger);
                color: white;
            }

        /* --- CONTENT AREA --- */
        #content {
            flex-grow: 1;
            padding: 1.5rem 0;
        }

        .admin-footer {
            background: white;
            padding: 1rem 0;
            border-top: 1px solid var(--border-color);
            font-size: 0.8rem;
            color: var(--text-muted);
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>

    <header id="top-header">
        <div class="nav-container">
            <a href="/Admin/Dashboard" class="brand-area">
                <div class="logo-box"><i class="fas fa-tooth"></i></div>
                <span class="main-title">Kiến Duy Dental</span>
            </a>
            <nav class="main-nav">
                <ul class="nav-links">
                    @* --- PHẦN MENU CHO BÁC SĨ --- *@
                    @if (Context.Session.GetString("Role") == "Bác sĩ")
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "BacSi" ? "active" : "")">
                            <a href="/BacSi"><i class="fas fa-user-md"></i> Dashboard Bác sĩ</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "BenhNhan" ? "active" : "")">
                            <a href="/Admin/BenhNhan/QuanLy"><i class="fas fa-user"></i> Bệnh nhân</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "LichHen" ? "active" : "")">
                            <a href="/Admin/LichHen/QuanLy"><i class="fas fa-calendar-alt"></i> Lịch khám</a>
                        </li>
                    }
                    @* --- PHẦN MENU CHO LỄ TÂN --- *@
                    else if (Context.Session.GetString("Role") == "Lễ tân")
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "LeTanHome" ? "active" : "")">
                            <a href="/letan"><i class="fas fa-desktop"></i> Dashboard</a>
                        </li>
                        
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "BenhNhan" ? "active" : "")">
                            <a href="/Admin/BenhNhan/QuanLy"><i class="fas fa-user"></i> Bệnh nhân</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "LichHen" ? "active" : "")">
                            <a href="/Admin/LichHen/QuanLy"><i class="fas fa-calendar-alt"></i> Lịch khám</a>
                        </li>
                        
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "DichVu" ? "active" : "")">
                            <a href="/Admin/DichVu"><i class="fas fa-stethoscope"></i> Dịch vụ</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "VatTu" ? "active" : "")">
                            <a href="/Admin/VatTu"><i class="fas fa-boxes-stacked"></i> Vật tư</a>
                        </li>
                    }
                    @* --- PHẦN MENU CHO ADMIN --- *@
                    else if (Context.Session.GetString("Role") == "Admin")
                    {
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Dashboard" ? "active" : "")">
                            <a href="/Admin/Dashboard"><i class="fas fa-home"></i> Dashboard</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "BenhNhan" ? "active" : "")">
                            <a href="/Admin/BenhNhan/QuanLy"><i class="fas fa-user"></i> Bệnh nhân</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "LichHen" ? "active" : "")">
                            <a href="/Admin/LichHen/QuanLy"><i class="fas fa-calendar-alt"></i> Lịch khám</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "NhanVien" ? "active" : "")">
                            <a href="/Admin/NhanVien/QuanLy"><i class="fas fa-user-tie"></i> Nhân sự</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "DichVu" ? "active" : "")">
                            <a href="/Admin/DichVu"><i class="fas fa-stethoscope"></i> Dịch vụ</a>
                        </li>
                        <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "VatTu" ? "active" : "")">
                            <a href="/Admin/VatTu"><i class="fas fa-boxes-stacked"></i> Vật tư</a>
                        </li>
                    }
                </ul>
            </nav>
            <div class="user-actions">
                <div class="user-profile d-none d-md-block">
                    <span class="user-name">@Context.Session.GetString("User")</span>
                    <span class="user-role">@Context.Session.GetString("Role")</span>
                </div>
                <a class="btn-logout" href="/Account/Logout" title="Đăng xuất">
                    <i class="fas fa-power-off"></i>
                </a>
            </div>
        </div>
    </header>

    <main id="content">
        <div class="container-fluid">
            @RenderBody()
        </div>
    </main>

    <footer class="admin-footer text-center">
        <span>© 2026 - Nha Khoa Kiến Duy | Quản lý phòng khám - lịch hẹn</span>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>