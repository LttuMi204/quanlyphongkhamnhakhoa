@model IEnumerable<quanlyphongkham.Models.BenhNhan>
@{
    string search = ViewBag.Search ?? "";
    string gioiTinh = ViewBag.GioiTinh ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

@Html.AntiForgeryToken()

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header py-3 bg-white d-flex justify-content-between align-items-center flex-wrap">
        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-list me-2"></i>Danh sách bệnh nhân</h6>
    </div>
    <div class="card-body">

        <form id="filterFormBN" class="row g-2 mb-3" onsubmit="searchBNForm(event)">
            <div class="col-md-8">
                <div class="input-group">
                    <input type="text" id="searchBN" class="form-control"
                           placeholder="Tìm theo họ tên, SĐT, email..."
                           value="@search"
                           oninput="debounceSearchBN()" />
                    <select id="filterGioiTinh" class="form-select" style="max-width: 180px;" onchange="searchBNForm(event)">
                        <option value="">Tất cả giới tính</option>
                        <option value="Nam" selected="@(gioiTinh == "Nam")">Nam</option>
                        <option value="Nữ" selected="@(gioiTinh == "Nữ")">Nữ</option>
                        <option value="Khác" selected="@(gioiTinh == "Khác")">Khác</option>
                    </select>
                    <button type="submit" class="btn btn-info text-white">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </button>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã BN</th>
                        <th>Họ tên</th>
                        <th>SĐT</th>
                        <th>Ngày sinh</th>
                        <th>Giới tính</th>
                        <th>Tài khoản liên kết</th>
                        <th class="text-center" width="150">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr onclick="viewBenhNhan(@item.MaBenhNhan)" style="cursor: pointer;" title="Nhấn để xem chi tiết">
                                <td>@item.MaBenhNhan</td>
                                <td class="fw-bold text-primary">@item.HoTen</td>
                                <td>@item.SoDienThoai</td>
                                <td>@(item.NgaySinh?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td>
                                    @if (item.GioiTinh == "Nữ")
                                    {
                                        <span class="badge bg-danger">Nữ</span>
                                    }
                                    else if (item.GioiTinh == "Nam")
                                    {
                                        <span class="badge bg-info text-dark">Nam</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@(item.GioiTinh ?? "—")</span>
                                    }
                                </td>
                                <td>
                                    @if (item.TaiKhoanNguoiDung != null)
                                    {
                                        <span class="badge bg-success">@item.TaiKhoanNguoiDung.TenDangNhap</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">Chưa có</span>
                                    }
                                </td>
                                <td class="text-center" onclick="event.stopPropagation()">
                                    <button class="btn btn-sm btn-info text-white" onclick="viewBenhNhan(@item.MaBenhNhan)" title="Chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                    <button class="btn btn-sm btn-warning" onclick="openEditBN(@item.MaBenhNhan)" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger" onclick="deleteBenhNhan(@item.MaBenhNhan)" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted py-3">Không tìm thấy bệnh nhân nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center mb-0">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="javascript:void(0)" onclick="loadTabDanhSach(@i)">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>