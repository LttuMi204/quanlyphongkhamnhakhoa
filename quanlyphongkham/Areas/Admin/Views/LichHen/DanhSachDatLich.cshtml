@model IEnumerable<quanlyphongkham.Models.LichHen>
@{
    ViewData["Title"] = "Tiếp nhận lịch từ Thành viên";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-3">
    <div class="row g-4">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 fw-bold" style="color: #72a1ff;"><i class="fas fa-user-check me-2"></i>Lịch hẹn từ Website</h6>
                    <span class="badge rounded-pill bg-light text-primary border" style="border-color: #72a1ff !important; color: #72a1ff !important;">
                        @Model.Count(x => x.TrangThai == "Chờ xác nhận") Mới
                    </span>
                </div>
                <div class="card-body p-0 overflow-auto" style="max-height: 75vh;">
                    <div class="list-group list-group-flush" id="memberRequestList">
                        @if (!Model.Any())
                        {
                            <div class="text-center py-5 text-muted small">Không có lịch hẹn nào</div>
                        }
                        else
                        {
                            @* TÁCH RIÊNG PHẦN CHƯA DUYỆT *@
                            var pendingList = Model.Where(x => x.TrangThai == "Chờ xác nhận");
                            var processedList = Model.Where(x => x.TrangThai != "Chờ xác nhận");

                            @if (pendingList.Any())
                            {
                                <div class="p-2 px-3 bg-light small fw-bold text-uppercase text-muted" style="font-size: 10px; letter-spacing: 1px;">
                                    Đang chờ xử lý (@pendingList.Count())
                                </div>
                                @foreach (var item in pendingList)
                                {
                                    <a href="javascript:void(0)" onclick="loadMemberRequestDetail(@item.MaLichHen)"
                                       class="list-group-item list-group-item-action p-3 request-item" id="req-@item.MaLichHen">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <strong class="text-dark">@item.BenhNhan.HoTen</strong>
                                            <small class="text-muted">@item.NgayDat.ToString("dd/MM")</small>
                                        </div>
                                        <div class="small text-muted">SĐT: @item.BenhNhan.SoDienThoai</div>
                                        <span class="badge bg-warning text-dark rounded-pill mt-1">@item.TrangThai</span>
                                    </a>
                                }
                            }

                            @if (processedList.Any())
                            {
                                <div class="p-2 px-3 bg-light small fw-bold text-uppercase text-muted mt-2" style="font-size: 10px; letter-spacing: 1px;">
                                    Đã xử lý gần đây
                                </div>
                                @foreach (var item in processedList)
                                {
                                    <a href="javascript:void(0)" onclick="loadMemberRequestDetail(@item.MaLichHen)"
                                       class="list-group-item list-group-item-action p-3 request-item opacity-75" id="req-@item.MaLichHen" style="background-color: #fafafa;">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-secondary fw-bold">@item.BenhNhan.HoTen</span>
                                            <small class="text-muted">@item.NgayDat.ToString("dd/MM")</small>
                                        </div>
                                        <div class="small text-muted">SĐT: @item.BenhNhan.SoDienThoai</div>
                                        <span class="badge @(item.TrangThai == "Hủy" ? "bg-danger" : "bg-success") rounded-pill mt-1">@item.TrangThai</span>
                                    </a>
                                }
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div id="memberRequestDetailPanel" class="card shadow-sm border-0 rounded-4 sticky-top" style="top: 20px; min-height: 500px;">
                <div class="card-body d-flex align-items-center justify-content-center text-muted">
                    <div class="text-center">
                        <i class="fas fa-mouse-pointer fa-3x mb-3 opacity-25" style="color: #72a1ff;"></i>
                        <p>Chọn một yêu cầu bên trái để xem chi tiết và xử lý</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadMemberRequestDetail(id) {
            $(".request-item").removeClass("active-request shadow-sm");
            $("#req-" + id).addClass("active-request shadow-sm");

            $("#memberRequestDetailPanel").html('<div class="text-center py-5"><div class="spinner-border" style="color: #72a1ff;"></div></div>');

            $.get('@Url.Action("GetChiTietDatLich", "LichHen")', { id: id }, function (data) {
                $("#memberRequestDetailPanel").html(data);
            });
        }
    </script>
    <style>
        .active-request {
            background-color: #f0f7ff !important;
            border-left: 5px solid #72a1ff !important;
        }
    </style>
}