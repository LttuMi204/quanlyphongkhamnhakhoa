@{
    ViewData["Title"] = "Báo Cáo";
}

<h2 class="mb-4">📊 Báo cáo tổng quan</h2>

<div class="row">

    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5>Tổng bệnh nhân</h5>
                <h2>@ViewBag.TongBenhNhan</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5>Tổng lịch hẹn</h5>
                <h2>@ViewBag.TongLichHen</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h5>Doanh thu</h5>
                <h2>@String.Format("{0:N0} đ", ViewBag.DoanhThu)</h2>
            </div>
        </div>
    </div>

</div>

<hr />

<a class="btn btn-primary mt-3">Xuất Excel</a>