@model quanlyphongkham.Models.YeuCauDatLich
@{
    ViewData["Title"] = "Chi tiết yêu cầu đặt lịch";
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Thông tin chi tiết yêu cầu #@Model.Id</h6>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <p><strong>Họ tên:</strong> @Model.HoTen</p>
                    <p><strong>Số điện thoại:</strong> @Model.SoDienThoai</p>
                    <p><strong>Có Zalo:</strong> @(Model.CoZalo ? "Có" : "Không")</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Địa chỉ:</strong> @Model.DiaChi</p>
                    <p><strong>Ngày gửi yêu cầu:</strong> @Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</p>
                    <p>
                        <strong>Trạng thái:</strong>
                        <span class="badge @(Model.TrangThai == "Chờ xử lý" ? "bg-warning text-dark" : Model.TrangThai == "Đã hủy" ? "bg-danger" : "bg-success")">
                            @Model.TrangThai
                        </span>
                    </p>
                </div>
            </div>

            <hr />

            <div class="d-flex justify-content-center mt-4 gap-3">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Quay lại
                </a>

                @if (Model.TrangThai == "Chờ xử lý")
                {
                    <button type="button" class="btn btn-danger" onclick="huyYeuCau(@Model.Id)">
                        <i class="fas fa-ban"></i> Hủy đặt lịch
                    </button>

                    <button type="button" class="btn btn-success" onclick="xacNhanLich(@Model.Id)">
                        <i class="fas fa-check"></i> Xác nhận
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        // Xử lý nút Xác nhận
        function xacNhanLich(id) {
            alert("Xác nhận thành công lịch hẹn, hệ thống sẽ chuyển sang giao diện xếp lịch. Vui lòng nhập thông tin lịch hẹn cho khách hàng này!");
            window.location.href = '@Url.Action("Duyet", "YeuCauDatLich", new { area = "Admin" })/' + id;
        }

        // Xử lý nút Hủy
        function huyYeuCau(id) {
            if (confirm('Bạn có chắc muốn hủy yêu cầu đặt lịch này?')) {
                var token = $('#antiForgeryForm input[name="__RequestVerificationToken"]').val();
                $.post('@Url.Action("Huy", "YeuCauDatLich", new { area = "Admin" })', { id: id, __RequestVerificationToken: token }, function (result) {
                    alert(result.message);
                    if (result.success) {
                        // Load lại trang để cập nhật trạng thái
                        window.location.reload();
                    }
                });
            }
        }
    </script>
}