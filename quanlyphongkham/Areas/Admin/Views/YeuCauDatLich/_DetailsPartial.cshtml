@model quanlyphongkham.Models.YeuCauDatLich

<div class="card border-0 shadow-none animate__animated animate__fadeIn">
    <div class="card-body p-4">
        <h6 class="fw-bold text-uppercase text-muted small mb-3">Chi tiết yêu cầu vãng lai</h6>

        <div class="p-3 rounded-4 mb-4" style="background-color: #f0f7ff;">
            <h5 class="fw-bold text-primary mb-1">@Model.HoTen.ToUpper()</h5>
            <div class="fw-bold text-dark">SĐT: @Model.SoDienThoai</div>
            <div class="small text-muted mt-1"><i class="fas fa-map-marker-alt me-1"></i>@(Model.DiaChi ?? "Không có địa chỉ")</div>
        </div>

        <div class="mb-4">
            <label class="small fw-bold">Trạng thái:</label>
            <span id="statusBadgeYc" class="badge @(Model.TrangThai == "Đã hủy" ? "bg-danger" : (Model.TrangThai == "Đã duyệt" ? "bg-success" : "bg-warning text-dark")) rounded-pill px-3">
                @Model.TrangThai
            </span>
        </div>

        <div id="actionAreaYc" class="d-flex gap-2">
            @if (Model.TrangThai == "Chờ xử lý")
            {
                <button class="btn btn-outline-danger w-50 rounded-pill fw-bold" onclick="xuLyYeuCau(@Model.Id, 'Huy')">TỪ CHỐI</button>
                <button class="btn btn-primary w-50 rounded-pill fw-bold shadow-sm" style="background-color: #72a1ff; border:none;" onclick="xuLyYeuCau(@Model.Id, 'Duyet')">DUYỆT YÊU CẦU</button>
            }
            else
            {
                <div class="alert alert-secondary w-100 text-center py-2 mb-0 rounded-pill small">
                    <i class="fas fa-check-circle me-1"></i> Yêu cầu này đã được xử lý xong
                </div>
            }
        </div>
    </div>
</div>

<script>
    function xuLyYeuCau(id, action) {
        let msg = action === 'Duyet' ? "Xác nhận DUYỆT yêu cầu này?" : "Xác nhận HỦY yêu cầu này?";
        if (!confirm(msg)) return;

        $.post('/Admin/YeuCauDatLich/XuLyNhanh', { id: id, tacVu: action }, function (res) {
            if (res.success) {
                toastr.success(res.message);
                location.reload(); // Load lại để cập nhật danh sách bên trái
            } else {
                toastr.error(res.message);
            }
        });
    }
</script>