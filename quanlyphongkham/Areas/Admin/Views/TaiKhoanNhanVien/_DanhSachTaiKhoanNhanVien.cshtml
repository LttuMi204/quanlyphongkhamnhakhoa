@model IEnumerable<quanlyphongkham.Areas.Admin.ViewModels.TaiKhoanNhanVienViewModel>

@{
    string search = ViewBag.Search ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-user-lock me-2"></i>Danh sách tài khoản nhân viên</h6>
    </div>
    <div class="card-body">
        <form class="row g-2 mb-3" onsubmit="searchTaiKhoanNhanVien(event)">
            <div class="col-md-6">
                <div class="input-group">
                    <input type="text" id="searchTkNhanVien" class="form-control"
                           placeholder="Tìm theo tên đăng nhập, nhân viên..."
                           value="@search"
                           oninput="debounceSearchTaiKhoan()" /> <button type="submit" class="btn btn-info text-white"><i class="fas fa-search"></i> Lọc</button>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Mã TK</th>
                        <th>Tên đăng nhập</th>
                        <th>Nhân viên sử dụng</th>
                        <th>Chức vụ</th>
                        <th>Ngày tạo</th>
                        <th>Trạng thái</th>
                        <th class="text-center" width="120">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            // Lấy Mã Nhân Viên tương ứng với tài khoản này để gọi form sửa chung
                            var maNhanVien = item.TaiKhoan.NhanViens?.FirstOrDefault()?.MaNhanVien;

                            <tr>
                                <td>@item.TaiKhoan.MaTaiKhoanNV</td>
                                <td><strong class="text-primary">@item.TaiKhoan.TenDangNhap</strong></td>
                                <td>@(item.HoTenNhanVien ?? "Chưa liên kết")</td>
                                <td><span class="badge bg-secondary">@(item.TenLoaiNV ?? "N/A")</span></td>
                                <td>@(item.TaiKhoan.NgayTao?.ToString("dd/MM/yyyy") ?? "")</td>
                                <td>
                                    <span class="badge @(item.TaiKhoan.TrangThai == "Hoạt động" ? "bg-success" : "bg-danger")">
                                        @item.TaiKhoan.TrangThai
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (maNhanVien != null)
                                    {
                                        <button class="btn btn-sm btn-warning" onclick="openEditNhanVien(@maNhanVien)" title="Sửa thông tin">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="btn btn-sm btn-danger" onclick="deleteNhanVien(@maNhanVien)" title="Xóa nhân viên & tài khoản">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted py-3">Không tìm thấy tài khoản nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center mb-0">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="javascript:void(0)" onclick="loadTabTaiKhoan(@i)">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>