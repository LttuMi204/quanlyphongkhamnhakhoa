@using System.Globalization
@model IEnumerable<quanlyphongkham.Models.GheNhaKhoa>

<div class="row row-cols-1 row-cols-md-3 row-cols-lg-5 g-2 mb-4">
    @{
        var stats = new[] {
    new { Label = "Tổng ghế", Value = Model.Count(), Color = "#6366f1" },
    new { Label = "Sẵn sàng", Value = Model.Count(g => g.TrangThai == "Trống"), Color = "#10b981" },
    new { Label = "Bảo trì", Value = Model.Count(g => g.TrangThai == "Bảo trì"), Color = "#ef4444" },
    new { Label = "Hỏng", Value = Model.Count(g => g.TrangThai == "Hỏng"), Color = "#f59e0b" }
    };
    }
    @foreach (var s in stats)
    {
        <div class="col">
            <div class="mini-stat-card border" style="border-left: 3px solid @s.Color !important; background: #fff; border-radius: 8px; padding: 8px 12px; height: 100%;">
                <div class="mini-stat-num" style="color: @s.Color; font-size: 1.25rem; font-weight: 800;">@s.Value</div>
                <div class="mini-stat-label" style="font-size: 0.65rem; color: #64748b; font-weight: 700; text-transform: uppercase;">@s.Label</div>
            </div>
        </div>
    }
</div>

<div class="card shadow-sm border-0 mb-4 animate__animated animate__fadeIn">
    <div class="card-header py-3 bg-white d-flex justify-content-between align-items-center">
        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-chair me-2"></i>Danh sách Ghế</h6>
        <button class="btn btn-primary btn-sm fw-bold rounded-3" onclick="openCreateGheModal()"><i class="fas fa-plus me-1"></i> Thêm ghế</button>
    </div>
    <div class="card-body">
        <form id="filterFormGhe" class="mb-4" onsubmit="searchGheForm(event)">
            <div class="input-group shadow-sm rounded-pill overflow-hidden border" style="max-width: 600px;">
                <span class="input-group-text bg-white border-0 text-primary ps-4"><i class="fas fa-search"></i></span>
                <input type="text" id="searchGheInput" name="search" class="form-control border-0 py-2 shadow-none fw-bold text-primary" placeholder="Tìm tên ghế, vị trí..." value="@ViewBag.Search" oninput="debounceSearchGhe()" />
                <select name="trangThai" class="form-select border-start border-0 fw-bold text-secondary" style="max-width: 150px;" onchange="searchGheForm(event)">
                    <option value="">Tất cả</option>
                    @{
                        var st = ViewBag.TrangThai as string;
                    }
                    <option value="Trống" selected="@(st == "Trống" ? "selected" : null)">Sẵn sàng</option>
                    <option value="Bảo trì" selected="@(st == "Bảo trì" ? "selected" : null)">Bảo trì</option>
                    <option value="Hỏng" selected="@(st == "Hỏng" ? "selected" : null)">Hỏng</option>
                </select>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-light text-uppercase" style="font-size: 0.75rem;">
                    <tr>
                        <th width="70" class="text-center">Mã</th>
                        <th>Tên ghế</th>
                        <th>Vị trí</th>
                        <th class="text-center">Vận hành hôm nay</th>
                        <th class="text-center" width="120">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        string statusClass = item.TrangThai == "Trống" ? "bg-success" : (item.TrangThai == "Bảo trì" ? "bg-danger" : "bg-warning text-dark");
                        int count = (int)(ViewData[$"LichHomNay_{item.MaGhe}"] ?? 0);

                        <tr style="cursor:pointer;" onclick="openEditGheModal(@item.MaGhe)">
                            <td class="text-center text-muted">#@item.MaGhe</td>
                            <td><strong>@item.TenGhe</strong></td>
                            <td><i class="fas fa-map-marker-alt me-1 text-danger"></i> @(item.ViTri ?? "—")</td>
                            <td class="text-center">
                                @if (item.TrangThai != "Trống")
                                {
                                    <span class="badge @statusClass rounded-pill px-3 py-2">@item.TrangThai</span>
                                }
                                else if (count == 0)
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2">Sẵn sàng</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark rounded-pill px-3 py-2">Đã xếp @count ca</span>
                                }
                            </td>
                            <td class="text-center" onclick="event.stopPropagation()">
                                <div class="d-flex gap-1 justify-content-center">
                                    <button class="btn btn-sm btn-warning" onclick="openEditGheModal(@item.MaGhe)"><i class="fas fa-edit"></i></button>
                                    <button class="btn btn-sm btn-danger" onclick="deleteGhe(@item.MaGhe)"><i class="fas fa-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    var searchGheTimeout;
    function debounceSearchGhe() {
        clearTimeout(searchGheTimeout);
        searchGheTimeout = setTimeout(() => { searchGheForm(); }, 400);
    }
    function searchGheForm(e) {
        if (e && e.preventDefault) e.preventDefault();
        var searchInput = document.getElementById('searchGheInput');
        var pos = searchInput ? searchInput.selectionStart : 0;
        $.get('@Url.Action("DanhSachGhePartial", "Ghe", new { area = "Admin" })', $('#filterFormGhe').serialize(), function (data) {
            $('#gheContainer').html(data);
            var ni = document.getElementById('searchGheInput');
            if (ni) { ni.focus(); ni.setSelectionRange(pos, pos); }
        });
    }
</script>
