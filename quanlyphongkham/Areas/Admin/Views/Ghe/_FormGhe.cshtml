@model quanlyphongkham.Models.GheNhaKhoa
@{
    bool isEdit = Model.MaGhe > 0;
    string formId = isEdit ? "formSuaGhe" : "formTaoGhe";
    string actionUrl = isEdit ? Url.Action("EditPartial", "Ghe", new { area = "Admin", id = Model.MaGhe }) : Url.Action("CreatePartial", "Ghe", new { area = "Admin" });
}

<style>
    .form-ghe-section {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 1.1rem 1.25rem;
        margin-bottom: 1rem;
    }

    .form-ghe-title {
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: #64748b;
        font-weight: 800;
        margin-bottom: 0.85rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .trang-thai-select {
        padding: 0.4rem 0.75rem;
        border-radius: 10px;
        border: 1.5px solid #e2e8f0;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        background: white;
        transition: all 0.2s;
    }

        .trang-thai-select.ts-trong {
            border-color: #10b981;
            color: #065f46;
            background: #f0fdf4;
        }

        .trang-thai-select.ts-baotri {
            border-color: #ef4444;
            color: #991b1b;
            background: #fef2f2;
        }

        .trang-thai-select.ts-hong {
            border-color: #f97316;
            color: #9a3412;
            background: #fff7ed;
        }

    .form-label-sm {
        font-size: 0.78rem;
        font-weight: 700;
        color: #475569;
        margin-bottom: 0.3rem;
    }

    .input-modern {
        border-radius: 10px;
        border: 1.5px solid #e2e8f0;
        padding: 0.5rem 0.85rem;
        font-size: 0.88rem;
        transition: all 0.2s;
        width: 100%;
    }

        .input-modern:focus {
            outline: none;
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
        }

    .preview-card {
        border: 2px solid #e2e8f0;
        border-radius: 14px;
        padding: 1.25rem;
        background: white;
        text-align: center;
        transition: all 0.3s;
    }

    .preview-icon {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        display: block;
    }

    .preview-name {
        font-size: 1rem;
        font-weight: 800;
        color: #1e293b;
    }

    .preview-pos {
        font-size: 0.78rem;
        color: #94a3b8;
    }
</style>

<form action="@actionUrl" method="post" id="@formId">
    @Html.AntiForgeryToken()
    @if (isEdit)
    {
        <input type="hidden" asp-for="MaGhe" />
    }

    <div class="row g-3">
        <div class="col-md-7 border-end">
            <div class="form-ghe-section">
                <div class="form-ghe-title"><i class="fas fa-chair text-primary"></i>Thông tin ghế</div>
                <div class="mb-3">
                    <label class="form-label-sm">Tên ghế <span class="text-danger">*</span></label>
                    <input asp-for="TenGhe" class="input-modern" placeholder="VD: Ghế 1..." required />
                </div>
                <div class="mb-3">
                    <label class="form-label-sm">Vị trí / Phòng</label>
                    <input asp-for="ViTri" class="input-modern" placeholder="VD: Phòng 1..." />
                </div>
                <div class="mb-3">
                    <label class="form-label-sm">Mô tả thêm</label>
                    <textarea asp-for="MoTa" class="input-modern" rows="2"></textarea>
                </div>
            </div>

            @if (isEdit)
            {
                <div class="form-ghe-section">
                    <div class="form-ghe-title"><i class="fas fa-traffic-light text-warning"></i>Trạng thái vận hành</div>
                    <div class="d-flex gap-2 flex-wrap">
                        <label class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 border" style="cursor:pointer;" id="lbl_trong">
                            <input type="radio" name="TrangThai" value="Trống" @(Model.TrangThai == "Trống" ? "checked" : "") onchange="updateTrangThaiUI()" style="display:none;">
                            <span>✅</span><span class="fw-bold small">Sẵn sàng</span>
                        </label>
                        <label class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 border" style="cursor:pointer;" id="lbl_baotri">
                            <input type="radio" name="TrangThai" value="Bảo trì" @(Model.TrangThai == "Bảo trì" ? "checked" : "") onchange="updateTrangThaiUI()" style="display:none;">
                            <span>🔧</span><span class="fw-bold small">Bảo trì</span>
                        </label>
                        <label class="d-flex align-items-center gap-2 px-3 py-2 rounded-3 border" style="cursor:pointer;" id="lbl_hong">
                            <input type="radio" name="TrangThai" value="Hỏng" @(Model.TrangThai == "Hỏng" ? "checked" : "") onchange="updateTrangThaiUI()" style="display:none;">
                            <span>⚠️</span><span class="fw-bold small">Hỏng</span>
                        </label>
                    </div>
                </div>
            }
            else
            {
                <input type="hidden" name="TrangThai" value="Trống" />
            }
        </div>

        <div class="col-md-5">
            <div class="form-ghe-title ps-1"><i class="fas fa-eye text-secondary"></i>Xem trước</div>
            <div class="preview-card" id="previewCard">
                <span class="preview-icon">🦷</span>
                <div class="preview-name" id="previewName">@(Model.TenGhe ?? "Tên ghế")</div>
                <div class="preview-pos" id="previewPos">@(Model.ViTri ?? "Vị trí chưa xác định")</div>
                <div id="previewStatus" class="mt-4">
                    <span class="badge" style="background:#f0fdf4;color:#15803d;border:1px solid #bbf7d0;padding:0.4rem 0.9rem;border-radius:999px;">✅ Hoạt động</span>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-footer px-0 pb-0 mt-3 border-top pt-3">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times me-1"></i>Đóng
        </button>

        <button type="submit" id="btnSubmitGhe" class="btn btn-primary">
            <i class="fas @(isEdit ? "fa-save" : "fa-plus-circle") me-1"></i>@(isEdit ? "Cập nhật Ghế" : "Thêm ghế mới")
        </button>
    </div>
</form>

<script>
    (function () {
        $('#TenGhe').on('input', function () { $('#previewName').text($(this).val().trim() || 'Tên ghế'); });
        $('#ViTri').on('input', function () { $('#previewPos').text($(this).val().trim() || 'Vị trí chưa xác định'); });

        $('#@formId').submit(function (e) {
            e.preventDefault();
            var form = $(this);
            var btn = $('#btnSubmitGhe');
            var orig = btn.html();
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Đang lưu...');
            $.ajax({
                type: 'POST', url: form.attr('action'), data: form.serialize(),
                success: function (res) {
                    if (res.success) {
                        $('#mainModal').modal('hide'); toastr.success(res.message); loadDanhSachGhe();
                        if (typeof loadLichTuan === 'function') loadLichTuan();
                        if (typeof loadDanhSachLich === 'function') loadDanhSachLich();
                    }
                    else { toastr.error(res.message); btn.prop('disabled', false).html(orig); }
                },
                error: function () { toastr.error('Lỗi kết nối!'); btn.prop('disabled', false).html(orig); }
            });
        });
    })();

    function updateTrangThaiUI() {
        var val = $('input[name="TrangThai"]:checked').val();
        $('#lbl_trong, #lbl_baotri, #lbl_hong').css({ 'background': 'white', 'border-color': '#e2e8f0', 'color': '#1e293b' });
        if (val === 'Trống') {
            $('#lbl_trong').css({ 'background': '#f0fdf4', 'border-color': '#10b981', 'color': '#065f46' });
            $('#previewStatus').html('<span class="badge" style="background:#f0fdf4;color:#15803d;border:1px solid #bbf7d0;padding:0.4rem 0.9rem;border-radius:999px;">✅ Sẵn sàng</span>');
        } else if (val === 'Bảo trì') {
            $('#lbl_baotri').css({ 'background': '#fef2f2', 'border-color': '#ef4444', 'color': '#991b1b' });
            $('#previewStatus').html('<span class="badge" style="background:#fef2f2;color:#dc2626;border:1px solid #fecaca;padding:0.4rem 0.9rem;border-radius:999px;">🔧 Đang bảo trì</span>');
        } else if (val === 'Hỏng') {
            $('#lbl_hong').css({ 'background': '#fff7ed', 'border-color': '#f97316', 'color': '#9a3412' });
            $('#previewStatus').html('<span class="badge" style="background:#fff7ed;color:#c2410c;border:1px solid #fdba74;padding:0.4rem 0.9rem;border-radius:999px;">⚠️ Đang hỏng</span>');
        }
    }
    updateTrangThaiUI();
</script>