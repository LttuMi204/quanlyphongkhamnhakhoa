@model IEnumerable<quanlyphongkham.Areas.Admin.ViewModels.TaiKhoanNguoiDungViewModel>

@{
    string search = ViewBag.Search ?? "";
    string filterBy = ViewBag.FilterBy ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header py-3 bg-white d-flex justify-content-between align-items-center flex-wrap">
        <h6 class="m-0 font-weight-bold text-primary"><i class="fas fa-users-cog me-2"></i>Danh sách Tài khoản Bệnh nhân</h6>
        <button class="btn btn-primary btn-sm" onclick="openCreateTK()">
            <i class="fas fa-plus"></i> Tạo tài khoản
        </button>
    </div>
    <div class="card-body">
        <form id="filterFormNguoiDung" class="row g-2 mb-3" onsubmit="searchTKForm(event)">
            <div class="col-md-8">
                <div class="input-group">
                    <input type="text" id="searchTkNguoiDung" class="form-control"
                           placeholder="Tìm theo tên đăng nhập, SĐT, email..."
                           value="@search"
                           oninput="debounceSearchTK()" />

                    <select id="filterByTkNguoiDung" class="form-select" style="max-width: 250px;" onchange="searchTKForm(event)">
                        <option value="">Lọc theo số lượng BN</option>
                        <option value="0" selected="@(filterBy == "0")">Chưa liên kết (0)</option>
                        <option value="1-5" selected="@(filterBy == "1-5")">Từ 1 - 5 bệnh nhân</option>
                        <option value="6-10" selected="@(filterBy == "6-10")">Từ 6 - 10 bệnh nhân</option>
                        <option value=">10" selected="@(filterBy == ">10")">Trên 10 bệnh nhân</option>
                    </select>

                    <button type="submit" class="btn btn-info text-white">
                        <i class="fas fa-search"></i> Tìm kiếm
                    </button>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Tên đăng nhập</th>
                        <th>Chủ tài khoản</th>
                        <th>Số điện thoại</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th class="text-center">Số BN</th>
                        <th class="text-center">Số hồ sơ</th>
                        <th class="text-center" width="150">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="row-clickable">
                                <td onclick="viewTaiKhoan(@item.TaiKhoan.MaTaiKhoan)" class="fw-bold text-success">@item.TaiKhoan.TenDangNhap</td>
                                <td onclick="viewTaiKhoan(@item.TaiKhoan.MaTaiKhoan)">@item.TaiKhoan.HoTen</td>
                                <td onclick="viewTaiKhoan(@item.TaiKhoan.MaTaiKhoan)">@item.TaiKhoan.SoDienThoai</td>
                                <td onclick="viewTaiKhoan(@item.TaiKhoan.MaTaiKhoan)">
                                    @if (item.TaiKhoan.TrangThai == "Hoạt động")
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@item.TaiKhoan.TrangThai</span>
                                    }
                                </td>
                                <td onclick="viewTaiKhoan(@item.TaiKhoan.MaTaiKhoan)">@(item.TaiKhoan.NgayTao?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                                <td onclick="viewTaiKhoan(@item.TaiKhoan.MaTaiKhoan)" class="text-center"><span class="badge bg-info text-dark">@item.SoBenhNhan</span></td>
                                <td onclick="viewTaiKhoan(@item.TaiKhoan.MaTaiKhoan)" class="text-center"><span class="badge bg-secondary">@item.SoHoSoKham</span></td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-info text-white" onclick="viewTaiKhoan(@item.TaiKhoan.MaTaiKhoan)" title="Chi tiết">
                                        <i class="fas fa-eye"></i>
                                    </button>

                                    

                                    <button class="btn btn-sm btn-danger" onclick="deleteTaiKhoan(@item.TaiKhoan.MaTaiKhoan)" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="8" class="text-center text-muted py-3">Không tìm thấy tài khoản nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-center mb-0">
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="javascript:void(0)" onclick="loadTabTaiKhoan(@i)">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>
