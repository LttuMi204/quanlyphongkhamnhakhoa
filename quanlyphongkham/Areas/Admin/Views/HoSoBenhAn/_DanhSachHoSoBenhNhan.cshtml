@model IEnumerable<quanlyphongkham.Models.HoSoBenhAn>
@{
    var benhNhan = ViewBag.BenhNhan as quanlyphongkham.Models.BenhNhan;
}

<div class="row">
    <div class="col-md-4 border-end pr-3">
        <h6 class="text-primary border-bottom pb-2 mb-3"><i class="fas fa-user-injured me-2"></i>Thông tin hồ sơ</h6>
        <table class="table table-sm table-borderless mb-3">
            <tr><th width="110" class="text-muted">Mã BN:</th><td><span class="badge bg-light text-dark border">#@benhNhan.MaBenhNhan</span></td></tr>
            <tr><th class="text-muted">Họ tên:</th><td class="text-primary fw-bold">@benhNhan.HoTen</td></tr>
            <tr><th class="text-muted">SĐT:</th><td class="fw-bold">@benhNhan.SoDienThoai</td></tr>
            <tr><th class="text-muted">Ngày sinh:</th><td>@(benhNhan.NgaySinh?.ToString("dd/MM/yyyy") ?? "N/A")</td></tr>
            <tr><th class="text-muted">Giới tính:</th><td>@benhNhan.GioiTinh</td></tr>
            <tr>
                <th class="text-muted">Tài khoản:</th>
                <td>
                    @(benhNhan.TaiKhoanNguoiDung != null ? benhNhan.TaiKhoanNguoiDung.TenDangNhap : "Khách vãng lai")
                </td>
            </tr>
        </table>

        <h6 class="text-danger border-bottom pb-2 mb-3"><i class="fas fa-notes-medical me-2"></i>Cảnh báo y tế</h6>
        <div class="mb-2">
            <span class="text-muted small d-block">Tiền sử bệnh:</span>
            <strong class="text-danger">@(string.IsNullOrEmpty(benhNhan.TienSuBenh) ? "Không có dữ liệu" : benhNhan.TienSuBenh)</strong>
        </div>
        <div class="mb-2">
            <span class="text-muted small d-block">Dị ứng:</span>
            <strong class="text-danger">@(string.IsNullOrEmpty(benhNhan.DiUng) ? "Không có" : benhNhan.DiUng)</strong>
        </div>
        <div class="mb-2">
            <span class="text-muted small d-block">Ghi chú từ bác sĩ:</span>
            <span class="text-info fst-italic">@(string.IsNullOrEmpty(benhNhan.GhiChuBacSi) ? "Không có" : benhNhan.GhiChuBacSi)</span>
        </div>
    </div>

    <div class="col-md-8 pl-3">

        <div id="danhSachKhamArea">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                <h6 class="text-info m-0"><i class="fas fa-history me-2"></i>Lịch sử khám bệnh (@Model.Count() lượt)</h6>
            </div>

            @if (Model.Any())
            {
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-hover align-middle">
                        <thead class="table-light" style="position: sticky; top: 0; z-index: 1;">
                            <tr>
                                <th>Ngày khám</th>
                                <th>Bác sĩ</th>
                                <th>Chẩn đoán tóm tắt</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var hs in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@hs.NgayKham.ToString("dd/MM/yyyy")</div>
                                        <div class="small text-muted">@hs.NgayKham.ToString("HH:mm")</div>
                                    </td>
                                    <td>@(hs.BacSi?.NhanVien?.HoTen ?? "N/A")</td>
                                    <td><span class="text-truncate d-inline-block" style="max-width: 150px;" title="@hs.ChanDoan">@(string.IsNullOrEmpty(hs.ChanDoan) ? "Chưa có" : hs.ChanDoan)</span></td>
                                    <td class="text-danger fw-bold">@hs.TongTien.ToString("N0")đ</td>
                                    <td>
                                        @if (hs.DaThanhToan)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check"></i> Đã thu</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="fas fa-clock"></i> Chờ thu</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-info" onclick="xemChiTietCaKham(@hs.MaHoSo)" title="Xem chi tiết hồ sơ này">
                                            <i class="fas fa-arrow-right"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="fas fa-box-open fa-3x mb-3 text-muted opacity-50"></i>
                    <p class="text-muted">Bệnh nhân này chưa có lượt khám nào được ghi nhận.</p>
                </div>
            }
        </div>

        <div id="chiTietKhamArea" style="display:none;">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3 bg-light p-2 rounded">
                <h6 class="text-primary m-0 fw-bold"><i class="fas fa-file-medical-alt me-2"></i>Chi tiết ca khám</h6>
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="quayLaiDanhSach()">
                    <i class="fas fa-arrow-left me-1"></i> Trở về lịch sử
                </button>
            </div>

            <div id="noidungChiTietKham">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted small">Đang tải dữ liệu...</p>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="modal-footer px-0 pb-0 mt-3 border-top pt-3">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng cửa sổ</button>
</div>

<script>
    function xemChiTietCaKham(maHoSo) {
        $('#danhSachKhamArea').hide();
        $('#chiTietKhamArea').fadeIn(300);

        $.get('@Url.Action("ChiTietPartial", "HoSoBenhAn", new { area = "Admin" })', { id: maHoSo }, function (data) {
            $('#noidungChiTietKham').html(data);
        }).fail(function () {
            $('#noidungChiTietKham').html('<div class="alert alert-danger">Không thể tải dữ liệu ca khám này.</div>');
        });
    }

    function quayLaiDanhSach() {
        $('#chiTietKhamArea').hide();
        $('#danhSachKhamArea').fadeIn(300);
        $('#noidungChiTietKham').html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-2 text-muted small">Đang tải dữ liệu...</p></div>');
    }
</script>