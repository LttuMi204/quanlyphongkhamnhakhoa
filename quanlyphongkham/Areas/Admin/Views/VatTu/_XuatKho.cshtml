@model IEnumerable<quanlyphongkham.Models.XuatKho>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-header bg-white py-3 border-bottom">
        <h6 class="m-0 font-weight-bold text-danger"><i class="fas fa-history me-2"></i>Nhật ký tiêu hao vật tư</h6>
    </div>
    <div class="card-body p-0">
        @if (Model != null && Model.Any())
        {
            <div class="list-group list-group-flush">
                @foreach (var item in Model)
                {
                    <div class="list-group-item p-3 border-start border-4 @(item.SoLuongXuat > 5 ? "border-danger" : "border-warning")">
                        <div class="d-flex w-100 justify-content-between">
                            <h6 class="mb-1 fw-bold text-dark">
                                <i class="fas fa-minus-circle text-danger me-1"></i> Xuất: @item.VatTu?.TenVatTu
                            </h6>
                            <small class="text-muted fw-bold">@item.NgayXuat.ToString("HH:mm - dd/MM/yyyy")</small>
                        </div>
                        <p class="mb-1 small text-muted">
                            <i class="fas fa-info-circle me-1"></i>
                            Số lượng: <strong class="text-danger">@item.SoLuongXuat @item.VatTu?.DonViTinh</strong> |
                            Lý do: @(item.LyDoXuat ?? "Dùng trong điều trị")
                        </p>
                        @if (item.MaHoSo.HasValue)
                        {
                            <small class="badge bg-light text-primary border border-primary">Hồ sơ bệnh án: #@item.MaHoSo</small>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fas fa-box-open fa-3x text-muted opacity-25 mb-3"></i>
                <p class="text-muted">Chưa có dữ liệu biến động kho gần đây.</p>
            </div>
        }
    </div>
</div>