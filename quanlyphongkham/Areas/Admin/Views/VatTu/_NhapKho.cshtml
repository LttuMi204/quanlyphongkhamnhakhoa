@model quanlyphongkham.Models.NhapKho
@{
    var dsVatTu = ViewBag.DichSachVatTu as List<quanlyphongkham.Models.VatTu>;
    int? selectedId = ViewBag.MaVatTuChon;
}

<div class="row">
    <div class="col-md-4 border-end">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold text-primary mb-0"><i class="fas fa-list me-2"></i>Chọn vật tư</h6>
            <button class="btn btn-sm btn-outline-primary shadow-sm" onclick="openFormVatTu(0)" title="Thêm mới vật tư vào danh mục">
                <i class="fas fa-plus"></i> Mới
            </button>
        </div>

        <div class="list-group shadow-sm" style="max-height: 500px; overflow-y: auto;">
            @foreach (var v in dsVatTu)
            {
                <button type="button" onclick="loadNhapKho(@v.MaVatTu)"
                        class="list-group-item list-group-item-action @(selectedId == v.MaVatTu ? "active shadow" : "")">
                    <div class="d-flex justify-content-between align-items-center">
                        <span>@v.TenVatTu</span>
                        <span class="badge @(selectedId == v.MaVatTu ? "bg-white text-primary" : "bg-primary") rounded-pill">Tồn: @v.SoLuongTon</span>
                    </div>
                </button>
            }
        </div>
    </div>

    <div class="col-md-8 ps-4">
        @if (selectedId.HasValue)
        {
            var curr = dsVatTu.First(x => x.MaVatTu == selectedId);
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-success text-white py-3">
                    <h6 class="mb-0 fw-bold"><i class="fas fa-file-import me-2"></i>Phiếu nhập: @curr.TenVatTu</h6>
                </div>
                <div class="card-body p-4">
                    <form id="formConfirmNhapKho">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="MaVatTu" value="@selectedId" />

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Số lượng nhập thêm (@curr.DonViTinh)</label>
                                <input type="number" name="SoLuongNhap" class="form-control form-control-lg border-primary rounded-pill text-center fw-bold" value="1" min="1" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">Đơn giá nhập thực tế (VNĐ)</label>
                                <input type="number" name="DonGiaNhap" class="form-control form-control-lg rounded-pill" value="@(curr.GiaNhap ?? 0)" step="1000" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold">Ghi chú phiếu nhập</label>
                            <textarea name="GhiChu" class="form-control rounded-3" rows="3" placeholder="Ví dụ: Nhập từ nhà cung cấp A, số hóa đơn 123..."></textarea>
                        </div>

                        <button type="button" onclick="submitNhapKhoFinal()" class="btn btn-success w-100 py-3 rounded-pill fw-bold shadow-sm">
                            <i class="fas fa-check-circle me-2"></i> XÁC NHẬN NHẬP KHO
                        </button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-light rounded-4 border-dashed">
                <i class="fas fa-hand-pointer fa-4x text-muted mb-3 opacity-25"></i>
                <h5 class="text-muted">Chưa chọn vật tư</h5>
                <p class="text-muted small">Chọn từ danh sách trái hoặc bấm "Mới" để thêm vật tư chưa có.</p>
            </div>
        }
    </div>
</div>

<script>
    function submitNhapKhoFinal() {
        var form = $('#formConfirmNhapKho');
        if (form.find('input[name="SoLuongNhap"]').val() <= 0) {
            toastr.warning("Số lượng nhập phải lớn hơn 0");
            return;
        }

        $.ajax({
            url: '@Url.Action("ProcessNhapKho", "VatTu")',
            type: 'POST',
            data: form.serialize(),
            success: function (res) {
                if (res.success) {
                    toastr.success(res.message);
                    loadDSVatTu(); // Cập nhật lại số lượng tồn ở Tab 1
                    loadNhapKho(@selectedId); // Refresh lại form bên phải
                } else {
                    toastr.error(res.message);
                }
            },
            error: function () {
                toastr.error("Có lỗi hệ thống xảy ra!");
            }
        });
    }
</script>