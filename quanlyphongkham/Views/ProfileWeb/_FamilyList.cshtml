@model IEnumerable<quanlyphongkham.Models.BenhNhanWebViewModel>
<div class="row g-3">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col-md-6">
                <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow" style="transition: 0.3s; cursor: pointer;" onclick="viewFamilyDetail(@item.MaBenhNhan)">
                    <div class="card-body d-flex align-items-center">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 me-3">
                            <i class="fa-solid fa-user-tag fa-xl"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0">@item.HoTen</h6>
                            <small class="text-muted">Quan hệ: @item.QuanHe</small>
                        </div>
                        <i class="fa-solid fa-chevron-right ms-auto text-muted"></i>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <img src="~/images/empty-family.png" style="width: 150px; opacity: 0.5;">
            <p class="text-muted mt-3">Chưa có thông tin người thân nào.</p>
        </div>
    }
</div>