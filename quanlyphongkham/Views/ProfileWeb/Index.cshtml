@model quanlyphongkham.Models.ProfileDashboardViewModel
@using System.Linq
@{
    ViewData["Title"] = "Trang cá nhân";
    Layout = "_Layout";
    var accountInfo = ViewBag.AccountInfo as quanlyphongkham.Models.TaiKhoanNguoiDung;
    var mainProfile = ViewBag.MainProfile as quanlyphongkham.Models.BenhNhan;
    var familyMembers = ViewBag.FamilyMembers as List<quanlyphongkham.Models.QuanHeBenhNhan>;
    // var lichHens = ViewBag.LichHens as List<quanlyphongkham.Models.LichHen>;
    // HoaDons là kiểu anonymous (ẩn danh) nên ta dùng var động (dynamic) trong vòng lặp
    var hoaDons = ViewBag.HoaDons as IEnumerable<dynamic>;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success text-center mb-0 rounded-0 shadow-sm">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger text-center mb-0 rounded-0 shadow-sm">@TempData["Error"]</div>
}

<section class="bg-primary bg-opacity-10 py-4 mb-4" style="border-radius: 0 0 30px 30px;">
    <div class="container">
        <div class="d-flex align-items-center">
            <img src="https://ui-avatars.com/api/?name=@mainProfile?.HoTen&background=0D8ABC&color=fff&rounded=true" alt="Avatar" class="rounded-circle shadow" width="80" height="80">
            <div class="ms-3">
                <h3 class="fw-bold mb-1">Chào mừng bạn đến với hồ sơ!</h3>

            </div>
        </div>
    </div>
</section>

<div class="container pb-5">
    <div class="row">
        <div class="col-lg-3 mb-4">
            <div class="card border-0 shadow-sm rounded-4 sticky-top" style="top: 90px;">
                <div class="card-body p-3">
                    <div class="nav flex-column nav-pills" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                        <button class="nav-link active text-start py-3 mb-1 rounded-pill fw-semibold" data-bs-toggle="pill" data-bs-target="#tab-hoso" type="button" role="tab">
                            <i class="fa-solid fa-user me-2"></i> Hồ sơ cá nhân
                        </button>
                        <button class="nav-link text-start py-3 mb-1 rounded-pill fw-semibold" data-bs-toggle="pill" data-bs-target="#tab-hosobenhAn" type="button" role="tab">
                            <i class="fa-solid fa-notes-medical me-2"></i> Hồ sơ bệnh án
                        </button>
                        <button class="nav-link text-start py-3 mb-1 rounded-pill fw-semibold" data-bs-toggle="pill" data-bs-target="#tab-lichkham" type="button" role="tab">
                            <i class="fa-regular fa-calendar-check me-2"></i> Lịch khám của tôi
                        </button>
                        <button class="nav-link text-start py-3 mb-1 rounded-pill fw-semibold" data-bs-toggle="pill" data-bs-target="#tab-nguoinha" type="button" role="tab">
                            <i class="fa-solid fa-users me-2"></i> Hồ sơ người nhà
                        </button>

                    </div>
                    <hr />
                    <a asp-controller="AccountWeb" asp-action="Logout" class="btn btn-outline-danger w-100 rounded-pill fw-bold">
                        <i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất
                    </a>
                </div>
            </div>
        </div>

        <div class="col-lg-9">
            <div class="tab-content bg-white p-4 shadow-sm rounded-4 border" id="v-pills-tabContent">

                <div class="tab-pane fade show active" id="tab-hoso" role="tabpanel">

                    @if (Model.MainProfile != null)
                    {
                        <div id="viewProfileMode">                            
                            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                                <h4 class="fw-bold text-primary mb-0"><i class="fas fa-id-card me-2"></i>Thông tin cá nhân</h4>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-outline-warning btn-sm rounded-pill px-4 fw-bold" data-bs-toggle="modal" data-bs-target="#changePasswordModal">
                                        <i class="fa-solid fa-key me-1"></i> Đổi mật khẩu
                                    </button>
                                    <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold" onclick="toggleEditMode(true)">
                                        <i class="fa-solid fa-pen-to-square me-1"></i> Cập nhật hồ sơ
                                    </button>
                                </div>
                            </div>
                            <div class="row g-4">
                                <div class="col-md-6 border-end pe-4">
                                    <h6 class="text-muted fw-bold mb-3">Thông tin liên hệ</h6>
                                    <table class="table table-borderless table-sm">
                                        <tr><th width="130" class="text-muted">Tên đăng nhập:</th><td class="fw-bold text-dark">@Model.AccountInfo.TenDangNhap</td></tr>
                                        <tr><th class="text-muted">Họ và tên:</th><td class="fw-bold text-primary">@Model.MainProfile.HoTen</td></tr>
                                        <tr><th class="text-muted">Số điện thoại:</th><td class="fw-bold">@Model.AccountInfo.SoDienThoai</td></tr>
                                        <tr><th class="text-muted">Email:</th><td>@(string.IsNullOrEmpty(Model.AccountInfo.Email) ? "Chưa cập nhật" : Model.AccountInfo.Email)</td></tr>
                                        <tr><th class="text-muted">Giới tính:</th><td>@Model.MainProfile.GioiTinh</td></tr>
                                        <tr><th class="text-muted">Ngày sinh:</th><td>@(Model.MainProfile.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</td></tr>
                                        <tr><th class="text-muted">Địa chỉ:</th><td>@(string.IsNullOrEmpty(Model.MainProfile.DiaChi) ? "Chưa cập nhật" : Model.MainProfile.DiaChi)</td></tr>
                                    </table>
                                </div>

                                <div class="col-md-6 ps-4">
                                    <h6 class="text-danger fw-bold mb-3"><i class="fas fa-heartbeat me-2"></i>Thông tin y tế</h6>
                                    <div class="mb-3 p-3 bg-light rounded-4 border">
                                        <strong class="d-block mb-1 text-dark">Tiền sử bệnh:</strong>
                                        <span class="text-muted small">@(string.IsNullOrEmpty(Model.MainProfile.TienSuBenh) ? "Không có / Chưa cập nhật" : Model.MainProfile.TienSuBenh)</span>
                                    </div>
                                    <div class="mb-3 p-3 bg-light rounded-4 border">
                                        <strong class="d-block mb-1 text-dark">Dị ứng (Thuốc/Thời tiết):</strong>
                                        <span class="text-muted small">@(string.IsNullOrEmpty(Model.MainProfile.DiUng) ? "Không có / Chưa cập nhật" : Model.MainProfile.DiUng)</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="editProfileMode" class="d-none">
                            <form id="formEditInline" asp-controller="ProfileWeb" asp-action="UpdateProfile" method="post">
                                @Html.AntiForgeryToken()

                                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                                    <h4 class="fw-bold text-warning mb-0"><i class="fas fa-user-edit me-2"></i>Chỉnh sửa hồ sơ</h4>
                                    <div>
                                        <button type="button" class="btn btn-light btn-sm rounded-pill px-3 me-2 fw-bold border" onclick="toggleEditMode(false)">Hủy bỏ</button>
                                        <button type="submit" class="btn btn-warning btn-sm rounded-pill px-4 fw-bold" id="btnSaveInline">
                                            <i class="fas fa-save me-1"></i> Lưu thay đổi
                                        </button>
                                    </div>
                                </div>

                                <div class="row g-4">
                                    <div class="col-md-6 border-end pe-4">
                                        <h6 class="text-muted fw-bold mb-3">Thông tin liên hệ</h6>

                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Họ và tên <span class="text-danger">*</span></label>
                                            <input type="text" name="HoTen" class="form-control" value="@Model.MainProfile.HoTen" required />
                                        </div>

                                        <div class="row">
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label small fw-bold">Giới tính</label>
                                                <select name="GioiTinh" class="form-select">
                                                    <!option value="Nam" @(Model.MainProfile.GioiTinh == "Nam" ? "selected" : "")>Nam</!option>
                                                    <!option value="Nữ" @(Model.MainProfile.GioiTinh == "Nữ" ? "selected" : "")>Nữ</!option>
                                                    <!option value="Khác" @(Model.MainProfile.GioiTinh == "Khác" ? "selected" : "")>Khác</!option>
                                                </select>
                                            </div>
                                            <div class="col-md-6 mb-3">
                                                <label class="form-label small fw-bold">Ngày sinh</label>
                                                <input type="date" name="NgaySinh" class="form-control" value="@(Model.MainProfile.NgaySinh?.ToString("yyyy-MM-dd"))" />
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Số điện thoại <span class="text-danger">*</span></label>
                                            <input type="text" name="SoDienThoai" class="form-control bg-light" value="@Model.AccountInfo.SoDienThoai" readonly />
                                            <small class="text-muted fst-italic">Liên hệ lễ tân nếu muốn đổi SĐT đăng nhập.</small>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Email</label>
                                            <input type="email" name="Email" class="form-control" value="@Model.AccountInfo.Email" />
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Địa chỉ chi tiết</label>
                                            <textarea name="DiaChi" class="form-control" rows="2">@Model.MainProfile.DiaChi</textarea>
                                        </div>
                                    </div>

                                    <div class="col-md-6 ps-4">
                                        <h6 class="text-danger fw-bold mb-3"><i class="fas fa-heartbeat me-2"></i>Thông tin y tế</h6>
                                        <div class="alert alert-warning small py-2 mb-3">
                                            <i class="fas fa-info-circle me-1"></i> Vui lòng khai báo chính xác để bác sĩ có phác đồ điều trị an toàn nhất.
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Tiền sử bệnh lý (Tim mạch, huyết áp...)</label>
                                            <textarea name="TienSuBenh" class="form-control" rows="3">@Model.MainProfile.TienSuBenh</textarea>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label small fw-bold">Dị ứng (Thuốc, thức ăn...)</label>
                                            <textarea name="DiUng" class="form-control" rows="3">@Model.MainProfile.DiUng</textarea>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                    }
                </div>
                <div class="tab-pane fade" id="tab-hosobenhAn" role="tabpanel">
                    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                        <h4 class="fw-bold text-primary mb-0">
                            <i class="fa-solid fa-file-medical me-2"></i>Lịch sử khám bệnh gia đình
                        </h4>
                        <div class="input-group w-50 shadow-sm rounded-pill overflow-hidden border">
                            <span class="input-group-text bg-white border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                            <input type="text" id="searchHoSoWeb" class="form-control border-0" placeholder="Tìm tên người nhà hoặc bệnh lý...">
                        </div>
                    </div>

                    <div class="row g-3" id="hoSoArea">
                        @if (ViewBag.AllMedicalRecords != null)
                        {
                            foreach (var hs in (IEnumerable<quanlyphongkham.Models.HoSoBenhAn>)ViewBag.AllMedicalRecords)
                            {
                                <div class="col-md-6 record-card" data-search="@hs.BenhNhan.HoTen.ToLower() @hs.ChanDoan?.ToLower()">
                                    <div class="card h-100 border-0 shadow-sm rounded-4 border-start border-primary border-4 p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <div class="fw-bold text-dark fs-5">@hs.BenhNhan.HoTen</div>
                                                <div class="small text-muted"><i class="fa-regular fa-calendar me-1"></i>@hs.NgayKham.ToString("dd/MM/yyyy")</div>
                                            </div>
                                            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3">#HS-@hs.MaHoSo</span>
                                        </div>

                                        <div class="p-2 bg-light rounded-3">
                                            <div class="mb-1"><strong class="small text-primary">Chẩn đoán:</strong> <span class="text-dark small">@hs.ChanDoan</span></div>
                                            <div class="mb-1"><strong class="small text-primary">Điều trị:</strong> <span class="text-dark small">@hs.PhuongPhapDieuTri</span></div>
                                            <div class="mb-0"><strong class="small text-primary">Bác sĩ:</strong> <span class="text-dark small">@hs.BacSi?.NhanVien?.HoTen</span></div>
                                        </div>

                                        @if (!string.IsNullOrEmpty(hs.LoiDan))
                                        {
                                            <div class="mt-2 fst-italic text-muted small">
                                                <i class="fa-solid fa-comment-medical me-1"></i> Lời dặn: @hs.LoiDan
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-5">
                                <p class="text-muted">Chưa có dữ liệu hồ sơ bệnh án.</p>
                            </div>
                        }
                    </div>
                </div>
                <div class="tab-pane fade" id="tab-lichkham" role="tabpanel">
                    <div id="lichKhamListContainer">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="fw-bold text-primary mb-0">Lịch khám của tôi</h4>
                            <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 fw-bold" onclick="showDatLichForm()">
                                <i class="fa-solid fa-plus me-1"></i> Đặt lịch mới
                            </button>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle border">
                                <thead class="table-light">
                                    <tr>
                                        <th>Họ tên</th>
                                        <th>Giờ hẹn</th>
                                        <th>Dịch vụ</th>
                                        <th>Bác sĩ</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.LichHens != null && Model.LichHens.Count > 0) // Sửa lỗi .Any()
                                    {
                                        foreach (var lh in Model.LichHens)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-bold">@lh.TenBenhNhan</div>
                                                    <small class="text-muted">Ngày: @lh.NgayHen.ToString("dd/MM/yyyy")</small>
                                                </td>
                                                <td class="fw-bold text-primary">@lh.GioHen.ToString(@"hh\:mm")</td>
                                                <td>@lh.TenDichVu</td>
                                                <td>@lh.TenBacSi</td>
                                                <td>
                                                    @if (lh.TrangThai == "Đã xác nhận")
                                                    {
                                                        <span class="badge bg-success">Đã xác nhận</span>
                                                    }
                                                    else if (lh.TrangThai == "Hủy")
                                                    {
                                                        <span class="badge bg-danger">Đã hủy</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">@lh.TrangThai</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="5" class="text-center text-muted py-4">Chưa có lịch khám nào.</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div id="datLichFormContainer" class="d-none"></div>
                </div>

                <div class="tab-pane fade" id="tab-nguoinha" role="tabpanel">
                    <div id="familyHeader" class="mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                            <h4 class="fw-bold text-primary mb-0">
                                <i class="fa-solid fa-users-gear me-2"></i>Quản lý hồ sơ người thân
                            </h4>
                            <button class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm" onclick="showAddFamilyForm()">
                                <i class="fa-solid fa-user-plus me-1"></i> Thêm người thân
                            </button>
                        </div>
                        <div class="input-group mb-3 shadow-sm rounded-pill overflow-hidden border">
                            <span class="input-group-text bg-white border-0"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                            <input type="text" id="searchFamilyInput" class="form-control border-0" placeholder="Tìm nhanh tên người thân...">
                        </div>
                    </div>

                    <div id="familyContentContainer">
                        @await Html.PartialAsync("_FamilyList", Model.FamilyMembers)
                    </div>
                </div>

                <div class="tab-pane fade" id="tab-thanhtoan" role="tabpanel">
                    <h4 class="fw-bold text-primary mb-4">Lịch sử thanh toán</h4>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle border">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã HS</th>
                                    <th>Ngày khám</th>
                                    <th>Tổng tiền</th>
                                    <th>Hình thức TT</th>
                                    <th>Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (hoaDons != null && hoaDons.Any())
                                {
                                    foreach (var item in hoaDons)
                                    {
                                        <tr>
                                            <td class="fw-bold">#HS@(item.HoSo.MaHoSo.ToString("D4"))</td>
                                            <td>@(item.HoSo.NgayKham?.ToString("dd/MM/yyyy"))</td>
                                            <td class="text-primary fw-bold">@(item.HoSo.TongTien?.ToString("N0"))đ</td>
                                            <td>@(item.ThanhToan?.HinhThucThanhToan ?? "N/A")</td>
                                            <td>
                                                @if (item.HoSo.DaThanhToan == true)
                                                {
                                                    <span class="badge bg-success">Đã thanh toán</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Chưa thanh toán</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="5" class="text-center text-muted py-4">Chưa có lịch sử giao dịch.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="tab-pane fade" id="tab-caidat" role="tabpanel">
                    <h4 class="fw-bold text-primary mb-4">Cài đặt thông báo & Liên kết</h4>
                    <div class="card bg-light border-0 rounded-4 mb-3 shadow-sm">
                        <div class="card-body d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="fw-bold mb-1"><i class="fa-brands fa-zalo text-primary fs-5 me-2"></i>Liên kết Zalo ZNS</h6>
                                <p class="small text-muted mb-0">Liên kết để nhận nhắc lịch tự động và kết quả X-Quang.</p>
                            </div>
                            <button class="btn btn-primary rounded-pill px-4 fw-bold">Liên kết ngay</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addFamilyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white border-0" style="border-radius: 1rem 1rem 0 0;">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-plus me-2"></i>Thêm hồ sơ người nhà</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form asp-controller="ProfileWeb" asp-action="AddFamilyMember" method="post">
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Họ và tên</label>
                        <input type="text" name="HoTen" class="form-control rounded-pill" placeholder="Nhập họ tên người nhà..." required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold">Quan hệ</label>
                            <select name="QuanHe" class="form-select rounded-pill" required>
                                <option value="Vợ">Vợ</option>
                                <option value="Chồng">Chồng</option>
                                <option value="Con">Con</option>
                                <option value="Cha">Cha</option>
                                <option value="Mẹ">Mẹ</option>
                                <option value="Anh">Anh</option>
                                <option value="Chị">Chị</option>
                                <option value="Em">Em</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-bold">Ngày sinh</label>
                            <input type="date" name="NgaySinh" class="form-control rounded-pill" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Ghi chú (Tình trạng cơ bản)</label>
                        <textarea name="GhiChu" class="form-control rounded-4" rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold py-2 shadow-sm">LƯU HỒ SƠ</button>
                </form>
            </div>
        </div>
    </div>
</div><script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
@section Script {
    <script>
        $(document).ready(function () {
            const urlParams = new URLSearchParams(window.location.search);

            // Xử lý khi có tham số ?action=datlich
            if (urlParams.get('action') === 'datlich') {
                // 1. Chuyển sang Tab "Lịch khám của tôi"
                const lichKhamTab = document.querySelector('button[data-bs-target="#tab-lichkham"]');
                if (lichKhamTab) {
                    bootstrap.Tab.getOrCreateInstance(lichKhamTab).show();

                    // 2. Tự động gọi hàm hiển thị Form đặt lịch
                    // Đợi một chút để Tab render xong rồi mới load Form AJAX
                    setTimeout(function () {
                        showDatLichForm();
                    }, 300);
                }
            }

            // Trường hợp 2: Link vào Hồ sơ người nhà (?action=nguoinha)
            if (urlParams.get('action') === 'nguoinha') {
                const familyTab = document.querySelector('button[data-bs-target="#tab-nguoinha"]');
                if (familyTab) {
                    bootstrap.Tab.getOrCreateInstance(familyTab).show();
                    // Tự động nạp danh sách và hiện Header (thanh tìm kiếm)
                    $('#familyHeader').show();
                    loadFamilyList();
                }
            }

            // Tìm kiếm Real-time người nhà
            $('#searchFamilyInput').on('keyup', function () {
                loadFamilyList();
            });

            // ================================================================
            // 2. CÁC HÀM TOÀN CỤC (WINDOW FUNCTIONS)
            // ================================================================

            // --- 2.1. Hồ sơ cá nhân (Chính chủ) ---
            window.toggleEditMode = function (isEditing) {
                if (isEditing) {
                    $('#viewProfileMode').addClass('d-none');
                    $('#editProfileMode').removeClass('d-none');
                } else {
                    $('#editProfileMode').addClass('d-none');
                    $('#viewProfileMode').removeClass('d-none');
                }
            };

            // --- 2.2. Quản lý người thân ---
            window.showAddFamilyForm = function () {
                $('#familyHeader').hide();
                $('#familyContentContainer').html('<div class="text-center py-5"><div class="spinner-border text-primary"></div><p class="mt-2">Đ đang tải biểu mẫu...</p></div>');
                $.get('/ProfileWeb/GetAddFamilyForm', function (res) {
                    $('#familyContentContainer').html(res);
                });
            };

            window.cancelAddFamily = function () {
                $('#familyHeader').show();
                loadFamilyList();
            };

            window.loadFamilyList = function () {
                var term = $('#searchFamilyInput').val();
                $.get('/ProfileWeb/SearchFamily', { term: term }, function (res) {
                    $('#familyContentContainer').html(res);
                });
            };

            window.viewFamilyDetail = function (id) {
                $('#familyHeader').hide();
                $('#familyContentContainer').html('<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>');
                $.get('/ProfileWeb/GetFamilyDetail/' + id, function (res) {
                    $('#familyContentContainer').html(res);
                });
            };

            window.editMember = function (id) {
                $('#familyContentContainer').html('<div class="text-center py-5"><div class="spinner-border text-warning"></div><p>Đang tải dữ liệu...</p></div>');
                $.get('/ProfileWeb/GetFamilyEditForm/' + id, function (res) {
                    $('#familyContentContainer').html(res);
                });
            };

            window.deleteMember = function (id) {
                if (confirm('Bạn có chắc muốn xóa người thân này khỏi danh sách quản lý?')) {
                    $.post('/ProfileWeb/DeleteFamilyMember/' + id, function (res) {
                        if (res.success) {
                            alert(res.message);
                            loadFamilyList();
                            $('#familyHeader').show();
                        }
                    });
                }
            };

            // --- 2.3. Quản lý lịch khám ---
            window.showDatLichForm = function () {
                $.get('/ProfileWeb/GetDatLichForm', function (res) {
                    $('#datLichFormContainer').html(res).removeClass('d-none');
                    $('#lichKhamListContainer').addClass('d-none');

                    // Scroll nhẹ xuống form để người dùng thấy
                    $('html, body').animate({
                        scrollTop: $("#datLichFormContainer").offset().top - 100
                    }, 500);
                });
            }; 
            http://googleusercontent.com/immersive_entry_chip/0

            window.cancelDatLich = function () {
                $('#datLichFormContainer').addClass('d-none').html('');
                $('#lichKhamListContainer').removeClass('d-none');
            };

            window.bookForMember = function (maBenhNhan) {
                const triggerEl = document.querySelector('#v-pills-tab button[data-bs-target="#tab-lichkham"]');
                bootstrap.Tab.getOrCreateInstance(triggerEl).show();
                showDatLichForm();
                setTimeout(() => {
                    $('#MaBenhNhan').val(maBenhNhan);
                }, 600);
            };

            // ================================================================
            // 3. XỬ LÝ SUBMIT CÁC FORM (DÙNG EVENT DELEGATION)
            // ================================================================

            // A. Cập nhật hồ sơ cá nhân (Inline Edit)
            $(document).on('submit', '#formEditInline', function (e) {
                e.preventDefault();
                var btn = $('#btnSaveInline');
                btn.prop('disabled', true).html('Đang lưu...');
                $.ajax({
                    type: 'POST',
                    url: $(this).attr('action'),
                    data: $(this).serialize(),
                    success: function (res) {
                        if (res.success) { alert(res.message); location.reload(); }
                        else { alert(res.message); btn.prop('disabled', false).html('Lưu thay đổi'); }
                    }
                });
            });

            // B. Thêm người nhà mới
            $(document).on('submit', '#formNewFamilyMember', function (e) {
                e.preventDefault();
                var btn = $('#btnSubmitAddFamily');
                btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-1"></i> Đang lưu...');
                $.ajax({
                    type: 'POST',
                    url: $(this).attr('action'),
                    data: $(this).serialize(),
                    success: function (res) {
                        if (res.success) { alert(res.message); location.reload(); }
                        else { alert("Lỗi: " + res.message); btn.prop('disabled', false).html('LƯU HỒ SƠ NGƯỜI THÂN'); }
                    },
                    error: function () { alert('Lỗi hệ thống!'); btn.prop('disabled', false).html('LƯU HỒ SƠ NGƯỜI THÂN'); }
                });
            });

            // C. Sửa người nhà
            $(document).on('submit', '#formEditFamilyMember', function (e) {
                e.preventDefault();
                var btn = $('#btnSubmitEditFamily');
                btn.prop('disabled', true).html('Đang lưu...');
                $.ajax({
                    type: 'POST',
                    url: $(this).attr('action'),
                    data: $(this).serialize(),
                    success: function (res) {
                        if (res.success) { alert(res.message); location.reload(); }
                        else { alert(res.message); btn.prop('disabled', false).html('LƯU THAY ĐỔI'); }
                    }
                });
            });

            // D. Đặt lịch khám mới
            $(document).on('submit', '#formNewLichHen', function (e) {
                e.preventDefault();
                var btn = $('#btnSubmitLich');
                btn.prop('disabled', true).html('Đang gửi...');
                $.ajax({
                    type: 'POST',
                    url: $(this).attr('action'),
                    data: $(this).serialize(),
                    success: function (res) {
                        if (res.success) { alert(res.message); location.reload(); }
                        else { alert(res.message); btn.prop('disabled', false).html('XÁC NHẬN ĐĂNG KÝ'); }
                    }
                });
            });
            // Tìm kiếm hồ sơ bệnh án theo tên
            $('#searchHoSoInput').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $("#hoSoBenhAnContainer .hoso-item").filter(function () {
                    $(this).toggle($(this).attr('data-name').indexOf(value) > -1);
                });
            });

            // Xem chi tiết lịch khám (Ở Tab Lịch khám của tôi)
            function viewLichHenDetail(id) {
                // Gọi AJAX load chi tiết lịch hẹn vào một Modal
                $.get('/LichHenWeb/GetDetail/' + id, function (res) {
                    $('#mainModalTitle').text("Chi tiết lịch khám");
                    $('#mainModalBody').html(res);
                    $('#mainModal').modal('show');
                });
            }
            // Tìm kiếm Real-time hồ sơ bệnh án
            $('#searchHoSoWeb').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $("#hoSoArea .record-card").filter(function () {
                    // Tìm theo tên bệnh nhân hoặc nội dung chẩn đoán đã đặt trong data-search
                    $(this).toggle($(this).data('search').indexOf(value) > -1);
                });
            });

            // Xem chi tiết hồ sơ bệnh án
            function viewRecordDetail(maHoSo) {
                // Mở Modal xem chi tiết
                $('#mainModalTitle').text("Chi tiết kết quả khám bệnh");
                $('#mainModalBody').html('<div class="text-center py-5"><div class="spinner-border text-primary"></div></div>');
                $('#mainModal').modal('show');

                // Bạn cần tạo 1 Action ChiTietPartial trong HoSoWebController
                $.get('/HoSoWeb/ChiTietPartial/' + maHoSo, function (data) {
                    $('#mainModalBody').html(data);
                });
            }
        });
    </script>
}<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-warning text-dark border-0">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-shield-halved me-2"></i>Thiết lập mật khẩu mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="formChangePassword">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Mật khẩu hiện tại</label>
                        <input type="password" name="OldPassword" class="form-control rounded-pill pwd-input" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Mật khẩu mới</label>
                        <input type="password" name="NewPassword" class="form-control rounded-pill pwd-input" id="newPwd" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Xác nhận mật khẩu mới</label>
                        <input type="password" name="ConfirmPassword" class="form-control rounded-pill pwd-input" required>
                    </div>
                    <div class="form-check mb-3 ms-2">
                        <input class="form-check-input" type="checkbox" id="showPwdProfile">
                        <label class="form-check-label small text-muted" for="showPwdProfile">Hiện mật khẩu</label>
                    </div>
                    <button type="submit" class="btn btn-warning w-100 rounded-pill fw-bold py-2 shadow-sm">XÁC NHẬN THAY ĐỔI</button>
                </form>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
    // Xử lý submit Đổi mật khẩu
    $(document).on('submit', '#formChangePassword', function (e) {
        e.preventDefault();
        const $form = $(this);
        const $btn = $form.find('button[type="submit"]');

        $btn.prop('disabled', true).text('Đang xử lý...');

        $.ajax({
            type: 'POST',
            url: '/AccountWeb/ChangePassword',
            data: $form.serialize(),
            success: function (res) {
                if (res.success) {
                    alert(res.message);
                    $('#changePasswordModal').modal('hide');
                    $form[0].reset();
                } else {
                    alert(res.message);
                }
                $btn.prop('disabled', false).text('XÁC NHẬN THAY ĐỔI');
            },
            error: function () {
                alert('Có lỗi hệ thống xảy ra.');
                $btn.prop('disabled', false).text('XÁC NHẬN THAY ĐỔI');
            }
        });
    });
    </script>
    }