@{
    ViewData["Title"] = "Liên hệ";
}

<section class="py-5 position-relative" style="background: linear-gradient(135deg, #f8f9fa 0%, #e0f7fa 100%); border-radius: 0 0 50px 50px; box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
    <div class="container text-center py-5">
        <span class="badge bg-primary px-3 py-2 rounded-pill text-uppercase mb-3 shadow-sm">Liên hệ với chúng tôi</span>
        <h1 class="fw-bold text-dark mb-3">Nha Khoa Kiến Duy</h1>
        <p class="text-muted lead mx-auto" style="max-width: 600px;">Chúng tôi luôn sẵn sàng lắng nghe và chăm sóc nụ cười của bạn. Hãy liên hệ với nha khoa ngay hôm nay!</p>
    </div>
</section>

<section class="py-5 mt-3">
    <div class="container">
        <div class="row g-4 align-items-stretch">

            <div class="col-lg-5 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-4 p-md-5">
                    <h4 class="fw-bold mb-4 text-primary">Thông tin phòng khám</h4>

                    <div class="d-flex align-items-start mb-4">
                        <div class="bg-light text-primary rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 50px; height: 50px; flex-shrink: 0;">
                            <i class="fa-solid fa-location-dot fs-5"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Địa chỉ</h6>
                            <p class="text-muted mb-0">47 Cách Mạng Tháng 8, Phường An Hòa, Quận Ninh Kiều, Cần Thơ</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start mb-4">
                        <div class="bg-light text-success rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 50px; height: 50px; flex-shrink: 0;">
                            <i class="fa-solid fa-phone fs-5"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Điện thoại</h6>
                            <p class="mb-0">
                                <a href="tel:0917917977" class="text-muted text-decoration-none fw-semibold">091 791 79 77</a>
                            </p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start mb-4">
                        <div class="bg-light text-info rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 50px; height: 50px; flex-shrink: 0;">
                            <i class="fa-brands fa-facebook-f fs-5"></i>
                        </div>
                        <div>
                            <h6 class="fw-bold mb-1">Facebook</h6>
                            <p class="mb-0">
                                <a href="https://www.facebook.com/NhakhoaKienHuy" target="_blank" class="text-muted text-decoration-none">facebook.com/NhakhoaKienHuy</a>
                            </p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start">
                        <div class="bg-light text-warning rounded-circle d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 50px; height: 50px; flex-shrink: 0;">
                            <i class="fa-regular fa-clock fs-5"></i>
                        </div>
                        <div class="w-100">
                            <h6 class="fw-bold mb-2">Giờ làm việc</h6>
                            <ul class="list-unstyled text-muted mb-0">
                                <li class="d-flex justify-content-between border-bottom pb-2 mb-2">
                                    <span>Thứ Hai - Thứ Bảy:</span>
                                    <span class="fw-semibold text-dark">08:00 - 19:30</span>
                                </li>
                                <li class="d-flex justify-content-between">
                                    <span>Chủ Nhật:</span>
                                    <span class="fw-semibold text-dark">08:00 - 17:00</span>
                                </li>
                            </ul>
                        </div>
                    </div>

                </div>
            </div>

            <div class="col-lg-7 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3928.8415184086433!2d105.770513!3d10.0299337!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTDCsDAxJzQ3LjgiTiAxMDXwnzQ2JzEzLjgiRQ!5e0!3m2!1sen!2s!4v1620000000000!5m2!1sen!2s"
                            width="100%"
                            height="100%"
                            style="border:0; min-height: 450px;"
                            allowfullscreen=""
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>

        </div>
    </div>
</section>