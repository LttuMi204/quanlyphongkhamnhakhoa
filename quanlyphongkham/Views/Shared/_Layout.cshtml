@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nha Khoa Kiến Duy</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    @*CHỈ load site.css, KHÔNG load admin.css *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    @*Navbar Web (giữ nguyên hoàn toàn) *@
    <nav class="navbar navbar-web navbar-expand-lg navbar-light fixed-top bg-white shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold text-primary fs-4"
               asp-controller="HomeWeb" asp-action="Index">
                <i class="fa-solid fa-tooth me-2"></i>Nha Khoa
                <span class="text-dark">Kiến Duy</span>
            </a>
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarMain">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-center">
                    <li class="nav-item me-3">
                        <a class="nav-link text-dark fw-semibold"
                           asp-controller="HomeWeb" asp-action="Index">Trang chủ</a>
                    </li>
                    <li class="nav-item me-3">
                        <a class="nav-link text-dark fw-semibold"
                           asp-controller="DichVuWeb" asp-action="Index">Dịch vụ</a>
                    </li>
                    <li class="nav-item me-3">
                        <a class="nav-link text-dark fw-semibold"
                           asp-controller="BangGiaWeb" asp-action="Index">Bảng giá</a>
                    </li>
                    <li class="nav-item me-3">
                        <a class="nav-link text-dark fw-semibold"
                           asp-controller="LienHeWeb" asp-action="Index">Liên hệ</a>
                    </li>
                    @* <li class="nav-item">
                        <a class="nav-link text-dark font-weight-bold" asp-controller="AI" asp-action="Index">
                            ✨ AI Chẩn Đoán (Mới)
                        </a>
                    </li> *@
                    @if (Context.Session.GetInt32("UserId") != null)
                    {
                        <li class="nav-item dropdown">
                            <a class="btn btn-outline-primary rounded-pill px-4 dropdown-toggle fw-bold"
                               href="#" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-circle-user me-1"></i>
                                Hồ sơ: @Context.Session.GetString("UserName")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 mt-2">
                                <li>
                                    <a class="dropdown-item py-2"
                                       asp-controller="ProfileWeb" asp-action="Index">
                                        <i class="fa-solid fa-id-card text-primary me-2"></i>
                                        Quản lý Trang cá nhân
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2"
                                       href="@Url.Action("Index", "ProfileWeb")?action=datlich#tab-lichkham">
                                        <i class="fa-solid fa-calendar-plus text-success me-2"></i>
                                        Đăng ký lịch khám
                                    </a>
                                </li>
                                <li>
                                    @* <a class="dropdown-item py-2"
                                       
                                        Đổi mật khẩu
                                    </a> *@
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item py-2 text-danger fw-bold"
                                       asp-controller="AccountWeb" asp-action="Logout">
                                        <i class="fa-solid fa-right-from-bracket me-2"></i>
                                        Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-outline-dark rounded-pill px-4 fw-bold"
                               asp-controller="AccountWeb" asp-action="Login">
                                <i class="fa-solid fa-right-to-bracket me-2"></i>
                                Tài Khoản
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main role="main" style="padding-top: 76px;">
        @RenderBody()
    </main>

    <footer class="site-footer bg-dark text-white pt-5 pb-3 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="fw-bold text-info mb-3">
                        <i class="fa-solid fa-tooth me-2"></i>Nha Khoa Kiến Duy
                    </h5>
                    <p class="text-white-50 small">
                        Hệ thống nha khoa tiêu chuẩn quốc tế. Chúng tôi cam kết mang lại
                        nụ cười rạng rỡ và sức khỏe răng miệng tốt nhất cho bạn.
                    </p>
                    <div class="d-flex gap-3 mt-3">
                        <a href="#" class="text-white fs-5"><i class="fab fa-facebook"></i></a>
                        <a href="#" class="text-white fs-5"><i class="fab fa-youtube"></i></a>
                        <a href="#" class="text-white fs-5"><i class="fab fa-tiktok"></i></a>
                    </div>
                </div>
                <div class="col-lg-4 col-md-6">
                    <h6 class="fw-bold mb-3">Thông tin liên hệ</h6>
                    <ul class="list-unstyled text-white-50 small">
                        <li class="mb-2">
                            <i class="fa-solid fa-location-dot me-2"></i>
                            123 Nguyễn Văn Cừ, TP. Cao Lãnh
                        </li>
                        <li class="mb-2">
                            <i class="fa-solid fa-phone me-2"></i> 0909 999 999
                        </li>
                        <li class="mb-2">
                            <i class="fa-solid fa-envelope me-2"></i>
                            tuvan@nhakhoakienduy.vn
                        </li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-12">
                    <h6 class="fw-bold mb-3">Giờ làm việc</h6>
                    <ul class="list-unstyled text-white-50 small">
                        <li class="d-flex justify-content-between">
                            <span>Thứ 2 - Thứ 7:</span> <span>8:00 - 20:00</span>
                        </li>
                        <li class="d-flex justify-content-between mt-2">
                            <span>Chủ nhật:</span> <span>8:00 - 17:00</span>
                        </li>
                    </ul>
                </div>
            </div>
            <hr class="border-secondary mt-4" />
            <div class="text-center text-white-50 small">
                © 2026 Nha Khoa Kiến Duy. All Rights Reserved.
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // Hiệu ứng cuộn Navbar
        window.addEventListener('scroll', function () {
            const navbar = document.querySelector('.navbar-web');
            if (window.scrollY > 10) {
                navbar.classList.add('scrolled', 'shadow-sm');
            } else {
                navbar.classList.remove('scrolled', 'shadow-sm');
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("Script", required: false)
</body>
</html>
